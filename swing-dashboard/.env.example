# ── IBKR (read-only) ─────────────────────────────────────────────
# IB Gateway: 4001 live, 4002 paper. TWS: 7496 live, 7497 paper.
# Start on PAPER until the first live run is verified.
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_READONLY=true

# Client Portal Gateway — REQUIRED for watchlists (see CLAUDE.md P0 #1).
IBKR_CP_URL=https://localhost:5000/v1/api

# ── Finnhub (free tier: register at finnhub.io) ──────────────────
FINNHUB_API_KEY=

# ── Cross-check tolerances (%) ───────────────────────────────────
TOL_CLOSE_PCT=0.25
TOL_VOLUME_PCT=5.0

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
